# --- Vercel (Next.js server) ---

# Robinhood Chain (4663). The public RPC is rate limited; use a provider endpoint in production.
ROBINHOOD_RPC=

# Privy server wallets: one per team, under a deny-by-default policy.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=

# Convex: the deployment URL, and the secret every Convex function checks (same value on both sides).
NEXT_PUBLIC_CONVEX_URL=
HOODIEBOT_SECRET=

# The brain: OpenRouter, then Groq, then Gemini (comma-separated keys rotate; a failing one sits out).
OPENROUTER_API_KEYS=
GROQ_API_KEYS=
GEMINI_API_KEYS=
# Optional model lists, comma separated, in order of preference
OPENROUTER_MODELS=
GROQ_MODELS=
GEMINI_MODELS=

# Signs session cookies. 32+ random characters.
SESSION_SECRET=
# Authorizes /api/cron/tick (called by the Convex cron).
CRON_SECRET=

# Optional: shown on the landing page once $HOODIE is live.
NEXT_PUBLIC_HOODIE_CA=
NEXT_PUBLIC_SITE_URL=https://usehoodiebot.com

# --- Convex dashboard env (npx convex env set NAME value) ---
# HOODIEBOT_SECRET   same as above
# SITE_URL           https://usehoodiebot.com
# CRON_SECRET        same as above
